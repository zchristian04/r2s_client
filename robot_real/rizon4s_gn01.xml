  <option integrator="implicitfast" cone="elliptic" impratio="10" noslip_iterations="10" />
  <include file="part_common_materials.xml" />
  <include file="part_gn01_gripper_assets.xml" />
  <include file="part_rizon4_arm.xml" />
</mujoco>
