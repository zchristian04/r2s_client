#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "World"
{
    def Xform "robot" (
        prepend apiSchemas = ["PhysicsArticulationRootAPI", "PhysxArticulationAPI"]
    )
    {
        bool physxArticulation:enabledSelfCollisions = 0
        int physxArticulation:solverPositionIterationCount = 32
        int physxArticulation:solverVelocityIterationCount = 1

        def "Looks"
        {
            def Material "gn01_dark"
            {
                token outputs:surface.connect = </World/robot/Looks/gn01_dark/shader.outputs:surface>

                def Shader "shader"
                {
                    uniform token info:id = "UsdPreviewSurface"
                    color3f inputs:diffuseColor = (0.015, 0.015, 0.014)
                    float inputs:metallic = 0
                    float inputs:roughness = 0.45
                    token outputs:surface
                }
            }

            def Material "gn01_tip"
            {
                token outputs:surface.connect = </World/robot/Looks/gn01_tip/shader.outputs:surface>

                def Shader "shader"
                {
                    uniform token info:id = "UsdPreviewSurface"
                    color3f inputs:diffuseColor = (0.035, 0.033, 0.03)
                    float inputs:metallic = 0
                    float inputs:roughness = 0.8
                    token outputs:surface
                }
            }

            def Material "flange"
            {
                token outputs:surface.connect = </World/robot/Looks/flange/shader.outputs:surface>

                def Shader "shader"
                {
                    uniform token info:id = "UsdPreviewSurface"
                    color3f inputs:diffuseColor = (0.62, 0.64, 0.62)
                    float inputs:metallic = 1
                    float inputs:roughness = 0.35
                    token outputs:surface
                }
            }

            def Material "pad_friction" (
                prepend apiSchemas = ["PhysicsMaterialAPI", "PhysxMaterialAPI"]
            )
            {
                float physics:dynamicFriction = 1
                float physics:restitution = 0
                float physics:staticFriction = 1
                token physxMaterial:frictionCombineMode = "max"
                token physxMaterial:restitutionCombineMode = "max"
            }

            def Material "body_friction" (
                prepend apiSchemas = ["PhysicsMaterialAPI", "PhysxMaterialAPI"]
            )
            {
                float physics:dynamicFriction = 0.5
                float physics:restitution = 0
                float physics:staticFriction = 0.5
                token physxMaterial:frictionCombineMode = "max"
                token physxMaterial:restitutionCombineMode = "max"
            }
        }

        def Xform "base" (
            prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysxRigidBodyAPI", "PhysxContactReportAPI", "PhysicsMassAPI"]
        )
        {
            point3f physics:centerOfMass = (0, 0, 0)
            float3 physics:diagonalInertia = (0.001, 0.001, 0.001)
            float physics:mass = 1
            quatf physics:principalAxes = (1, 0, 0, 0)
            float physxContactReport:threshold = 0
            bool physxRigidBody:disableGravity = 1
            quatd xformOp:orient = (1, 0, 0, 0)
            double3 xformOp:translate = (0, 0, 0)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]
        }

        def Xform "x" (
            prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysxRigidBodyAPI", "PhysxContactReportAPI", "PhysicsMassAPI"]
        )
        {
            point3f physics:centerOfMass = (0, 0, 0)
            float3 physics:diagonalInertia = (0.00001, 0.00001, 0.00001)
            float physics:mass = 0.01
            quatf physics:principalAxes = (1, 0, 0, 0)
            float physxContactReport:threshold = 0
            bool physxRigidBody:disableGravity = 1
            quatd xformOp:orient = (1, 0, 0, 0)
            double3 xformOp:translate = (-0.25, 0, 0)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]
        }

        def Xform "y" (
            prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysxRigidBodyAPI", "PhysxContactReportAPI", "PhysicsMassAPI"]
        )
        {
            point3f physics:centerOfMass = (0, 0, 0)
            float3 physics:diagonalInertia = (0.00001, 0.00001, 0.00001)
            float physics:mass = 0.01
            quatf physics:principalAxes = (1, 0, 0, 0)
            float physxContactReport:threshold = 0
            bool physxRigidBody:disableGravity = 1
            quatd xformOp:orient = (1, 0, 0, 0)
            double3 xformOp:translate = (-0.25, 0, 0)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]
        }

        def Xform "z" (
            prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysxRigidBodyAPI", "PhysxContactReportAPI", "PhysicsMassAPI"]
        )
        {
            point3f physics:centerOfMass = (0, 0, 0)
            float3 physics:diagonalInertia = (0.002, 0.002, 0.002)
            float physics:mass = 0.5
            quatf physics:principalAxes = (1, 0, 0, 0)
            float physxContactReport:threshold = 0
            bool physxRigidBody:disableGravity = 1
            quatd xformOp:orient = (1, 0, 0, 0)
            double3 xformOp:translate = (-0.25, 0, 0.25)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]
        }

        def Xform "a" (
            prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysxRigidBodyAPI", "PhysxContactReportAPI", "PhysicsMassAPI"]
        )
        {
            point3f physics:centerOfMass = (0, 0, 0)
            float3 physics:diagonalInertia = (0.00001, 0.00001, 0.00001)
            float physics:mass = 0.01
            quatf physics:principalAxes = (1, 0, 0, 0)
            float physxContactReport:threshold = 0
            bool physxRigidBody:disableGravity = 1
            quatd xformOp:orient = (1, 0, 0, 0)
            double3 xformOp:translate = (-0.25, 0, 0.25)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]
        }

        def Xform "b" (
            prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysxRigidBodyAPI", "PhysxContactReportAPI", "PhysicsMassAPI"]
        )
        {
            point3f physics:centerOfMass = (0, 0, 0)
            float3 physics:diagonalInertia = (0.00001, 0.00001, 0.00001)
            float physics:mass = 0.01
            quatf physics:principalAxes = (1, 0, 0, 0)
            float physxContactReport:threshold = 0
            bool physxRigidBody:disableGravity = 1
            quatd xformOp:orient = (1, 0, 0, 0)
            double3 xformOp:translate = (-0.25, 0, 0.25)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]
        }

        def Xform "stage" (
            prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysxRigidBodyAPI", "PhysxContactReportAPI", "PhysicsMassAPI"]
        )
        {
            point3f physics:centerOfMass = (0, 0, 0)
            float3 physics:diagonalInertia = (0.00001, 0.00001, 0.00001)
            float physics:mass = 0.01
            quatf physics:principalAxes = (1, 0, 0, 0)
            float physxContactReport:threshold = 0
            bool physxRigidBody:disableGravity = 1
            quatd xformOp:orient = (1, 0, 0, 0)
            double3 xformOp:translate = (-0.25, 0, 0.25)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]
        }

        def Xform "tool" (
            prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysxRigidBodyAPI", "PhysxContactReportAPI", "PhysicsMassAPI"]
        )
        {
            point3f physics:centerOfMass = (-0.000101517704, 0.00007721697, -0.17184511)
            float3 physics:diagonalInertia = (0.0006902931, 0.0009563809, 0.0010421004)
            float physics:mass = 0.79088
            quatf physics:principalAxes = (-0.7063794, 0.011200108, 0.7077347, 0.0037861352)
            float physxContactReport:threshold = 0
            bool physxRigidBody:disableGravity = 1
            quatd xformOp:orient = (1, 0, 0, 0)
            double3 xformOp:translate = (-0.25, 0, 0.57212)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]

            def Mesh "base_visual" (
                prepend apiSchemas = ["MaterialBindingAPI"]
            )
            {
                int[] faceVertexCounts = [3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3,